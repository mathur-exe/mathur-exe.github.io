{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-google-antigravity-auth"
  ],
  "provider": {
    "google": {
      "models": {
        "gemini-claude-sonnet-4-5": {
          "id": "gemini-claude-sonnet-4-5",
          "name": "Claude Sonnet 4.5 (via Antigravity)",
          "reasoning": true
        },
        "gemini-claude-sonnet-4-5-thinking": {
          "id": "gemini-claude-sonnet-4-5-thinking",
          "name": "Claude Sonnet 4.5 Thinking (via Antigravity)",
          "reasoning": true
        },
        "gemini-claude-opus-4-5-thinking": {
          "id": "gemini-claude-opus-4-5-thinking",
          "name": "Claude Opus 4.5 Thinking (via Antigravity)",
          "reasoning": true
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.2": {
          "options": {
            "reasoningEffort": "medium"
          }
        },
        "gpt-5.2-codex": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_MCP_PAT}"
      }
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/sse",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled" : true,
    },
    "huggingface": {
	"type" : "remote",
	"url" : "https://huggingface.co/mcp",
	"enabled" : false,
	"headers" : {
	   "Authorization": "Bearer {env:HF_MCP_TOKEN}"
	}
    }
  },
  "permission": { 
	  "bash": "allow", 
	  "external_directory": { 
		"read": "allow", 
		"write": "ask" 
	  } 
  } 
}
