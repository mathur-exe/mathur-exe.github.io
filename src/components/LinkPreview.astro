---
interface Props {
  title: string;
  description: string;
  url: string;
}

const { title, description, url } = Astro.props;
---

<a href={url} target="_blank" rel="noopener noreferrer" class="link-preview">
  <div class="preview-icon">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="icon">
      <path
        d="M9 19C4 19 2 17 2 12C2 7 4 5 9 5H15C20 5 22 7 22 12C22 17 20 19 15 19H9Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M2 12L22 12"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
      <path
        d="M9 12V15.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
  <div class="preview-content">
    <span class="preview-title">{title}</span>
    <span class="preview-description">{description}</span>
  </div>
</a>

<style>
  .link-preview {
    display: flex;
    align-items: flex-start;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 12px;
    margin: 1.5rem 0;
    text-decoration: none;
    color: inherit;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
    background-color: #fff;
  }

  .link-preview:hover {
    background-color: #f9f9f9;
    border-color: #bababa;
    text-decoration: none;
    color: inherit;
  }

  .preview-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    margin-right: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: 4px;
    color: #666;
  }

  .icon {
    width: 24px;
    height: 24px;
  }

  .preview-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .preview-title {
    font-weight: 600;
    font-size: 1rem;
    color: #111;
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .preview-description {
    font-size: 0.85rem;
    color: var(--meta-color);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 600px) {
    .link-preview {
      align-items: center;
    }
  }
</style>
