---
import { Code } from 'astro:components';

interface Props {
  url: string;
  lang?: string;
  repoPath?: string; // Optional: Override displayed path
}

const { url, lang = 'markdown' } = Astro.props;

// Parse the raw URL to extract owner, repo, and path
// Format: https://raw.githubusercontent.com/:owner/:repo/:branch/:path...
const match = url.match(/raw\.githubusercontent\.com\/([^/]+)\/([^/]+)\/([^/]+)\/(.+)/);

let fileContent = 'Loading...';
let commitMessage = 'Last commit info unavailable';
let lastUpdated = '';
let displayPath = '';
let repoLink = '';
let error = '';

if (match) {
  const [_, owner, repo, branch, path] = match;
  // Show relative path after the base skills directory
  const baseDir = 'PaperNotes/dotfiles/codex/';
  const relativePath = path.startsWith(baseDir) ? path.slice(baseDir.length) : path;
  displayPath = relativePath;
  // Link to the actual file on GitHub (not just the repo)
  repoLink = `https://github.com/${owner}/${repo}/blob/${branch}/${path}`;
  
  try {
    // 1. Fetch Raw Content
    const contentRes = await fetch(url);
    if (contentRes.ok) {
      fileContent = await contentRes.text();
    } else {
      error = `Failed to fetch file content: ${contentRes.statusText}`;
      fileContent = error;
    }

    // 2. Fetch Commit Metadata (Last commit for this file)
    // Using PAT for higher rate limits (5000/hr vs 60/hr unauthenticated)
    const githubToken = process.env.GITHUB_MCP_PAT || import.meta.env.GITHUB_MCP_PAT;
    const apiHeaders: HeadersInit = {
        'User-Agent': 'Astro-Personal-Site'
    };
    if (githubToken) {
        apiHeaders['Authorization'] = `token ${githubToken}`;
    }
    
    const apiRes = await fetch(`https://api.github.com/repos/${owner}/${repo}/commits?path=${path}&per_page=1`, {
        headers: apiHeaders
    });
    
    if (apiRes.ok) {
        const commits = await apiRes.json();
        if (commits.length > 0) {
            const commit = commits[0];
            commitMessage = commit.commit.message.split('\n')[0]; // First line only
            const date = new Date(commit.commit.author.date);
            
            // Format time ago (simple approximation)
            const diff = (new Date().getTime() - date.getTime()) / 1000;
            if (diff < 60) lastUpdated = 'just now';
            else if (diff < 3600) lastUpdated = `${Math.floor(diff / 60)} minutes ago`;
            else if (diff < 86400) lastUpdated = `${Math.floor(diff / 3600)} hours ago`;
            else lastUpdated = date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
        }
    }
  } catch (e) {
    error = `Error: ${e.message}`;
    fileContent = error;
  }
} else {
    error = 'Invalid GitHub Raw URL';
    fileContent = error;
}
---

<div class="gist-viewer">
  {error ? (
      <div class="error-msg">{error}</div>
  ) : (
      <>
        <div class="gist-header">
            <div class="header-top">
                <a href={repoLink} target="_blank" rel="noopener noreferrer" class="file-path">{displayPath}</a>
                {lastUpdated && <span class="last-updated">{lastUpdated}</span>}
            </div>
            <div class="commit-row">
                <span class="commit-msg">{commitMessage}</span>
            </div>
        </div>
        
        <div class="gist-code">
            <Code code={fileContent} lang={lang as any} theme="github-dark" />
        </div>
      </>
  )}
</div>

<style>
  .gist-viewer {
    border: 1px solid #333;
    border-radius: 8px;
    background: #141414;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    display: flex;
    flex-direction: column;
    max-height: 60vh;
  }

  .gist-header {
    background: #1a1a1a;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid #333;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex-shrink: 0;
  }

  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
  }

  .file-path {
    font-size: 0.75rem;
    color: #666;
    text-decoration: none;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .file-path:hover {
    color: #888;
  }

  .last-updated {
    font-size: 0.75rem;
    color: #666;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .commit-row {
    display: none;
  }

  /* Code Area - scrollable */
  .gist-code {
    background: #141414;
    overflow: auto;
    flex: 1;
    min-height: 0;
  }

  /* Override Astro Code styles to match reference site */
  :global(.gist-code pre) {
    margin: 0 !important;
    padding: 1rem !important;
    border: none !important;
    background: #141414 !important;
    border-radius: 0 !important;
    font-size: 0.875rem !important;
    line-height: 1.6 !important;
    white-space: pre-wrap !important;
    word-wrap: break-word !important;
    overflow-wrap: break-word !important;
    color: #999 !important;
  }

  :global(.gist-code code) {
    color: #999 !important;
    white-space: pre-wrap !important;
    word-wrap: break-word !important;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace !important;
  }

  /* Remove syntax highlighting colors - use single muted color */
  :global(.gist-code .line) {
    color: #999 !important;
  }
  
  :global(.gist-code span) {
    color: inherit !important;
  }

  .error-msg {
    padding: 1rem;
    color: #f85149;
    font-family: monospace;
  }
</style>
