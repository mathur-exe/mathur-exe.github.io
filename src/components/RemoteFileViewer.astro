---
import { Code } from 'astro:components';

interface Props {
  url: string;
  lang?: string;
  repoPath?: string; // Optional: Override displayed path
}

const { url, lang = 'markdown' } = Astro.props;

// Parse the raw URL to extract owner, repo, and path
// Format: https://raw.githubusercontent.com/:owner/:repo/:branch/:path...
const match = url.match(/raw\.githubusercontent\.com\/([^/]+)\/([^/]+)\/([^/]+)\/(.+)/);

let fileContent = 'Loading...';
let commitMessage = 'Last commit info unavailable';
let lastUpdated = '';
let displayPath = '';
let repoLink = '';
let error = '';

if (match) {
  const [_, owner, repo, branch, path] = match;
  displayPath = `${repo} / ${path}`;
  repoLink = `https://github.com/${owner}/${repo}`;
  
  try {
    // 1. Fetch Raw Content
    const contentRes = await fetch(url);
    if (contentRes.ok) {
      fileContent = await contentRes.text();
    } else {
      error = `Failed to fetch file content: ${contentRes.statusText}`;
      fileContent = error;
    }

    // 2. Fetch Commit Metadata (Last commit for this file)
    // Rate limits apply: 60/hr for unauthenticated.
    const apiRes = await fetch(`https://api.github.com/repos/${owner}/${repo}/commits?path=${path}&per_page=1`, {
        headers: {
            'User-Agent': 'Astro-Personal-Site'
        }
    });
    
    if (apiRes.ok) {
        const commits = await apiRes.json();
        if (commits.length > 0) {
            const commit = commits[0];
            commitMessage = commit.commit.message.split('\n')[0]; // First line only
            const date = new Date(commit.commit.author.date);
            
            // Format time ago (simple approximation)
            const diff = (new Date().getTime() - date.getTime()) / 1000;
            if (diff < 60) lastUpdated = 'just now';
            else if (diff < 3600) lastUpdated = `${Math.floor(diff / 60)} minutes ago`;
            else if (diff < 86400) lastUpdated = `${Math.floor(diff / 3600)} hours ago`;
            else lastUpdated = date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
        }
    }
  } catch (e) {
    error = `Error: ${e.message}`;
    fileContent = error;
  }
} else {
    error = 'Invalid GitHub Raw URL';
    fileContent = error;
}
---

<div class="gist-viewer">
  {error ? (
      <div class="error-msg">{error}</div>
  ) : (
      <>
        <div class="gist-header">
            <div class="meta-row top">
                <a href={repoLink} target="_blank" class="repo-link">{displayPath}</a>
                {/* Removed stars/forks as requested */}
            </div>
            <div class="meta-row bottom">
                <div class="commit-info">
                    <span class="commit-msg">{commitMessage}</span>
                </div>
                {lastUpdated && <span class="last-updated">Active {lastUpdated}</span>}
            </div>
        </div>
        
        <div class="gist-code">
            <Code code={fileContent} lang={lang as any} theme="github-dark" />
        </div>
      </>
  )}
</div>

<style>
  .gist-viewer {
    border: 1px solid #30363d;
    border-radius: 6px;
    background: #0d1117;
    overflow: hidden;
    margin-top: 1rem;
    max-width: 652px; /* Restricted width as requested */
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
  }

  .gist-header {
    background: #0d1117;
    padding: 1rem;
    border-bottom: 1px solid #30363d;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-row {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
  }

  /* Row 1: File Path */
  .repo-link {
      color: #58a6ff;
      font-weight: 600;
      text-decoration: none;
      font-size: 0.9rem;
  }
  .repo-link:hover {
      text-decoration: underline;
  }

  /* Row 2: Commit & Date */
  .meta-row.bottom {
      font-size: 0.8rem;
      color: #8b949e;
      margin-top: 4px;
      font-family: monospace; 
  }

  .commit-msg {
      color: #c9d1d9;
      margin-right: 1rem;
  }

  /* Code Area */
  .gist-code {
      background: #0d1117;
      overflow-x: auto;
  }

  /* Override Astro Code styles to be seamless */
  :global(.gist-code pre) {
      margin: 0 !important;
      padding: 1rem !important;
      border: none !important;
      background: transparent !important;
      border-radius: 0 !important;
      font-size: 0.85rem !important;
      line-height: 1.5 !important;
  }

  .error-msg {
      padding: 1rem;
      color: #f85149;
      font-family: monospace;
  }
</style>
