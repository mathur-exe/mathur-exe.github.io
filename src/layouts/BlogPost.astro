---
import BaseLayout from '../layouts/BaseLayout.astro';
const { frontmatter } = Astro.props;

const layoutClass = frontmatter.layoutType === 'wide'
  ? 'layout-wide'
  : frontmatter.layoutType === 'tml'
    ? 'layout-tml'
    : undefined;
---
<BaseLayout title={frontmatter.title} layoutClass={layoutClass}>
  <article>
    <header style="margin-bottom: 2rem;">
      <h1>{frontmatter.title}</h1>
      {frontmatter.date && <p style="color: var(--meta-color);">{frontmatter.date}</p>}
    </header>
    
    <div class="content">
      <slot />
    </div>

    <footer style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--border-color);">
      <a href="https://substantial-soap-96f.notion.site/Gaurang-s-Website-155c76b2a8e9806d946af3d2b258ed3e">← Back to Home</a>
    </footer>
  </article>
</BaseLayout>
