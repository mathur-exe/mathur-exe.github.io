---
import '../styles/global.css';

interface Props {
	title: string;
	tabs?: { 
        label: string; 
        id: string;
        items?: { label: string; url?: string; }[]; // Updated to object with url support
    }[];
}

const { title, tabs = [] } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Personal Website" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- KaTeX -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
	</head>
	<body>
		<div class="council-layout">
			<!-- Sidebar -->
			<aside class="sidebar">
				<div class="sidebar-header">
					<a href="/" class="home-link">← mathur.exe</a>
				</div>
                
                {tabs.length > 0 && (
                    <nav class="tabs-nav">
                        {tabs.map((tab, index) => (
                            <div class="nav-group">
                                <button 
                                    class={`tab-btn ${index === 0 ? 'active' : ''}`} 
                                    data-target={tab.id}
                                >
                                    {tab.label}
                                </button>
                                
                                {tab.items && tab.items.length > 0 && (
                                    <ul class="sub-menu">
                                        {tab.items.map(item => (
                                            <li class="skill-item" data-repo-url={typeof item === 'string' ? undefined : item.url}>
                                                {typeof item === 'string' ? item : item.label}
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        ))}
                    </nav>
                )}
				
				<div class="separator"></div>
                
                <div class="usage-tip">
                    <p>Send ideas to <a href="#">@mathur_exe</a></p>
                </div>

			</aside>

			<!-- Main Content -->
			<main class="main-content">
				<slot />
			</main>
		</div>

		<script>
			// Vanilla JS Tab Switching & Dynamic Viewer
			document.addEventListener('DOMContentLoaded', () => {
				const buttons = document.querySelectorAll('.tab-btn');
				const panels = document.querySelectorAll('.tab-panel');

				// Init: hide all except first (or active)
                if (panels.length > 0) {
                    panels.forEach((p, i) => {
                         if (i === 0) p.style.display = 'block';
                         else p.style.display = 'none';
                    });
                }

				buttons.forEach(btn => {
					btn.addEventListener('click', () => {
						buttons.forEach(b => b.classList.remove('active'));
						btn.classList.add('active');
						panels.forEach(p => (p as HTMLElement).style.display = 'none');
						const targetId = btn.getAttribute('data-target');
						const targetPanel = document.getElementById(targetId || '');
						if (targetPanel) {
							targetPanel.style.display = 'block';
						}
					});
				});

                // --- Dynamic Skill Viewer Logic ---
                const skillButtons = document.querySelectorAll('.skill-item');
                const viewerContainer = document.querySelector('.viewer-container');
                
                async function updateViewer(url) {
                    if (!viewerContainer) return;

                    const match = url.match(/raw\.githubusercontent\.com\/([^/]+)\/([^/]+)\/([^/]+)\/(.+)/);
                    if (!match) return;
                    const [_, owner, repo, branch, path] = match;
                    
                    const codeBlock = viewerContainer.querySelector('code');
                    if (codeBlock) codeBlock.innerText = "Loading...";

                    try {
                        const contentRes = await fetch(url);
                        const fileContent = await contentRes.text();

                        const apiRes = await fetch(`https://api.github.com/repos/${owner}/${repo}/commits?path=${path}&per_page=1`);
                        let commitMsg = "Commit info unavailable";
                        let timeAgo = "";
                        
                        if (apiRes.ok) {
                            const commits = await apiRes.json();
                            if (commits.length > 0) {
                                commitMsg = commits[0].commit.message.split('\n')[0];
                                const date = new Date(commits[0].commit.author.date);
                                const diff = (new Date().getTime() - date.getTime()) / 1000;
                                if (diff < 60) timeAgo = 'just now';
                                else if (diff < 3600) timeAgo = `${Math.floor(diff / 60)} minutes ago`;
                                else if (diff < 86400) timeAgo = `${Math.floor(diff / 3600)} hours ago`;
                                else timeAgo = date.toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
                            }
                        }

                        const linkEl = viewerContainer.querySelector('.repo-link');
                        const msgEl = viewerContainer.querySelector('.commit-msg');
                        const timeEl = viewerContainer.querySelector('.last-updated');
                        const codeEl = viewerContainer.querySelector('code');

                        if (linkEl) {
                            (linkEl as HTMLAnchorElement).href = `https://github.com/${owner}/${repo}`;
                            (linkEl as HTMLElement).innerText = `${repo} / ${path}`;
                        }
                        if (msgEl) (msgEl as HTMLElement).innerText = commitMsg;
                        if (timeEl) (timeEl as HTMLElement).innerText = `Active ${timeAgo}`;
                        if (codeEl) codeEl.textContent = fileContent;

                    } catch (e) {
                        console.error("Viewer update failed", e);
                    }
                }

                skillButtons.forEach(btn => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation(); 
                        const url = btn.getAttribute('data-repo-url');
                        if (url) {
                            skillButtons.forEach(b => b.classList.remove('active'));
                            btn.classList.add('active');
                            updateViewer(url);
                        }
                    });
                });
			});
		</script>

		<style>
			/* Council Layout Specific Styles */
			:root {
				--sidebar-width: 176px; /* w-44 */
                --sidebar-bg: transparent;
                --sidebar-text: #888;
                --sidebar-text-active: #fff;
                --main-bg: #0d0d0d;
                --border-color: #333;
			}

            body {
                background-color: var(--main-bg);
                color: #e0e0e0;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                margin: 0;
                overflow: hidden; /* App-like */
                height: 100vh;
            }

			.council-layout {
				display: flex;
                flex-direction: row;
                align-items: flex-start;
                gap: 24px;
                padding: 0;
                max-width: 1200px;
                margin: 0 auto;
                padding-top: 2rem;
			}

			/* Sidebar */
			.sidebar {
                width: var(--sidebar-width);
                flex: 0 0 auto;
				background-color: var(--sidebar-bg);
				padding: 0;
                /* Optional: internal padding if needed, but reference had gap handling separation */
				display: flex;
				flex-direction: column;
			}

            .sidebar-header {
                margin-bottom: 2rem;
            }
            .home-link {
                color: var(--sidebar-text-active);
                text-decoration: none;
                font-size: 0.9rem;
                font-weight: 500;
            }

			.section-title {
				font-size: 0.75rem;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				color: #555;
				margin-bottom: 1rem;
				font-weight: 600;
			}

            .tabs-nav {
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
                margin-bottom: 2rem;
            }

            .nav-group {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
            }

            .tab-btn {
                background: none;
                border: none;
                text-align: left;
                color: var(--sidebar-text);
                padding: 0.5rem 0.75rem;
                border-radius: 6px;
                cursor: pointer;
                font-size: 0.95rem; /* Slightly larger for main headers */
                transition: all 0.2s;
                font-weight: 500;
            }

            .tab-btn:hover {
                color: var(--sidebar-text-active);
            }

            .tab-btn.active {
                color: var(--sidebar-text-active);
            }

			.sub-menu {
				list-style: none;
				padding: 0;
                padding-left: 1rem;
				margin: 0;
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
			}
            
            .sub-menu li {
                color: #666; /* Dimmer than main labels */
                font-family: "Fira Code", monospace;
                font-size: 0.85rem;
                cursor: pointer;
                padding: 0.2rem 0.5rem;
                border-radius: 4px;
                transition: color 0.2s;
            }
            .sub-menu li:hover {
                color: var(--sidebar-text-active);
                background: rgba(255,255,255,0.03);
            }

            .separator {
                height: 1px;
                background-color: var(--border-color);
                margin: 2rem 0;
            }
            
            .usage-tip {
                margin-top: auto;
                font-size: 0.85rem;
                color: var(--sidebar-text);
            }
            .usage-tip a {
                color: var(--sidebar-text);
                text-decoration: none;
            }

			/* Main Content */
			.main-content {
				background-color: transparent;
                flex: 1;
                min-width: 0; /* Important for flex child truncation */
                position: relative;
			}

            /* Global overrides for this view */
            :global(h1) {
                color: #fff;
                font-size: 1.8rem;
                margin-top: 2rem;
            }
            :global(p) {
                color: #ccc;
            }
            :global(pre) {
                background: #1a1a1a !important;
                border: 1px solid #333;
            }

            @media (max-width: 768px) {
                .council-layout {
                    grid-template-columns: 1fr;
                    height: auto;
                    overflow: visible;
                }
                .sidebar {
                    height: auto;
                    border-bottom: 1px solid var(--border-color);
                }
                body {
                    overflow: auto;
                }
            }

            /* Content Styles (moved from MDX) */
            .tab-panel {
                padding: 2rem 3rem;
                max-width: 900px;
                margin: 0 auto;
                animation: fadeIn 0.3s ease;
            }
            
            .tab-panel h3 {
                font-size: 1.5rem;
                color: #fff;
                margin-bottom: 0.5rem;
                border-bottom: 1px solid #333;
                padding-bottom: 1rem;
            }
            
            .tab-panel p {
                color: #888;
                margin-bottom: 2rem;
            }

            .note-card {
                background: rgba(255,255,255,0.05);
                border: 1px solid #333;
                padding: 1rem;
                border-radius: 6px;
                color: #ccc;
            }

            @keyframes fadeIn {
                from { opacity: 0; transform: translateY(5px); }
                to { opacity: 1; transform: translateY(0); }
            }
		</style>
	</body>
</html>
