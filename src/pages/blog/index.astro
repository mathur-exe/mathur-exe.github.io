---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

function formatDate(date: Date) {
    return date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric'
    });
}
---

<BaseLayout title="Writing">
	<article>
        <section style="margin-bottom: 3rem;">
            <h1 style="margin-bottom: 2rem;">Writing</h1>
            
            <div class="blog-list">
                {posts.map((post) => (
                    <div class="blog-item">
                        <div class="post-date">{formatDate(post.data.pubDate)}</div>
                        <div class="post-title">
                            <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
                        </div>
                    </div>
                ))}
            </div>
        </section>

        <section>
             <p style="margin-top: 4rem;">
                <a href="https://substantial-soap-96f.notion.site/Gaurang-s-Website-155c76b2a8e9806d946af3d2b258ed3e">← Back to Home</a>
            </p>
        </section>
    </article>

    <style>
        .blog-list {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .blog-item {
            display: flex;
            flex-direction: column;
        }

        .post-date {
            font-family: var(--font-mono, monospace);
            font-size: 0.85rem;
            color: var(--meta-color, #666);
            margin-bottom: 0.25rem;
        }

        .post-title {
            font-size: 1.1rem;
            line-height: 1.4;
        }

        .post-title a {
            text-decoration: none;
            color: var(--text-color, #333);
            border-bottom: 1px solid transparent;
            transition: border-color 0.2s ease;
        }

        .post-title a:hover {
            border-bottom-color: var(--accent-color, #000);
        }

        /* Desktop style for side-by-date */
        @media (min-width: 640px) {
            .blog-item {
                flex-direction: row;
                align-items: baseline;
                gap: 2rem;
            }

            .post-date {
                flex-shrink: 0;
                width: 120px;
                margin-bottom: 0;
            }
        }
    </style>
</BaseLayout>
