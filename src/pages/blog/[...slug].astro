---
import { getCollection } from 'astro:content';
import CouncilLayout from '../../layouts/CouncilLayout.astro';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const post = Astro.props;
const { Content } = await post.render();

// Specific logic for useful-prompts dynamic skills attached to 'cursor' tab
let computedTabs = post.data.tabs ? JSON.parse(JSON.stringify(post.data.tabs)) : [];

if (post.slug === 'useful-prompts') {
    const cursorTab = computedTabs.find((t: any) => t.id === 'cursor');
    if (cursorTab) {
         try {
            const githubToken = process.env.GITHUB_MCP_PAT || import.meta.env.GITHUB_MCP_PAT;
            const headers: HeadersInit = {
                'User-Agent': 'Astro-Personal-Site'
            };
            if (githubToken) {
                headers['Authorization'] = `token ${githubToken}`;
            }
            
            const res = await fetch('https://api.github.com/repos/mathur-exe/annotation-notes/contents/PaperNotes/dotfiles/codex/skills', { headers });
            
            if (res.ok) {
                const data = await res.json();
                const skills = data
                    .filter((item: any) => item.type === 'dir')
                    .map((item: any) => ({
                        label: item.name,
                        url: `https://raw.githubusercontent.com/mathur-exe/annotation-notes/main/${item.path}/SKILL.md`
                    }));
                cursorTab.items = skills;
            }
        } catch (e) {
            console.error("Failed to fetch skills for useful-prompts", e);
        }
    }
}
---

{
    post.data.layoutType === 'council' ? (
        <CouncilLayout title={post.data.title} description={post.data.description} tabs={computedTabs}>
            <Content />
        </CouncilLayout>
    ) : (
        <BlogPost frontmatter={post.data}>
            <Content />
        </BlogPost>
    )
}
